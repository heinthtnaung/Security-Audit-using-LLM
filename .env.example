# The council's settings: the model server, its members, and the escalation model.
# Copy to `.env` and change what you need; an environment variable of the same name
# wins over the file. Only these seven AUDITOR_* keys are read, and a misspelt one
# is refused.

# The default model a client uses when none is named; audit names its own members,
# so an audit never uses it.
AUDITOR_MODEL=qwen2.5:7b-instruct

# The Ollama server. This machine, unless AUDITOR_REMOTE_SERVER below is yes.
AUDITOR_SERVER_URL=http://127.0.0.1:11434

# Only `yes` lets AUDITOR_SERVER_URL name another machine. Every advisory text the
# council reads is then sent there, and the record says it did not run locally.
# AUDITOR_REMOTE_SERVER=yes

AUDITOR_TIMEOUT_SECONDS=180
AUDITOR_CONTEXT_TOKENS=8192

# The models `audit --council` runs, comma-separated, e.g. gemma4:latest,qwen2.5:7b-instruct.
AUDITOR_COUNCIL_MEMBERS=

# One larger model on the same server for a metric the council left open, e.g.
# qwen2.5:14b. Unset or empty: no escalation.
AUDITOR_ESCALATION_MODEL=
